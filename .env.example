# Copy to .env (or export these in your shell).
# .env is gitignored - never commit real credentials.

# Gemini API key for the LLM briefing stage (src/llm_insights.py).
# Any one of these three names is accepted. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: pin a specific model instead of the built-in failover pool.
# GEMINI_MODEL=gemini-2.5-pro

# Optional: point at a CRM extract outside the repository.
# Defaults to data/raw/, which is committed.
# CRM_DATA_DIR=C:\path\to\DataSet
